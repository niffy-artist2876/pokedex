graph ER {
  graph [overlap=false, splines=true, fontname="Helvetica", label="Pokedex - Chen notation", labelloc=t];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, len=1.2];
