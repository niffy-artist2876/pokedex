# Copy to .env (same folder) and fill in. .env is git-ignored.

# Owner/superuser connection: used by database/setup_db.py, dataset/seed.py and the tests
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/pokedex

# Only with docker-compose.yml (PostgreSQL 18 + pgvector on port 5433); then use
# DATABASE_URL=postgresql://postgres:<DOCKER_DB_PASSWORD>@localhost:5433/pokedex
DOCKER_DB_PASSWORD=

# Password for the pokedex_app login role the web backend will use
# (setup_db.py applies it). The backend then connects with:
#   postgresql://pokedex_app:<APP_DB_PASSWORD>@localhost:5432/pokedex
APP_DB_PASSWORD=

# Optional: seed.py creates this admin and a default VGC format
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web app (web/), which reads this same file
APP_DATABASE_URL=postgresql://pokedex_app:<APP_DB_PASSWORD>@localhost:5433/pokedex
# Long random string used to sign login cookies
SESSION_SECRET=
